{
  "name": "shopnest",
  "version": "1.0.0",
  "author": "Shivansh Vasu",
  "description": "Full-Stack MERN E-Commerce App",
  "scripts": {
    "install-all": "npm install && npm --prefix ../frontend install",
    "build": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "start": "node server.js",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "nodemon server.js",
    "start:frontend": "npm --prefix ../frontend run dev",
    "seed": "node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "concurrently": "^8.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.8"
  },
  "main": "seed.js",
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mukesh9012/Apna_Store_backend.git"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mukesh9012/Apna_Store_backend/issues"
  },
  "homepage": "https://github.com/Mukesh9012/Apna_Store_backend#readme"
}
